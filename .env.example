# ─── TrustSource API configuration ───────────────────────────────────────────
# Copy to .env and fill in:  cp .env.example .env
# Defaults run on Base Sepolia TESTNET (no real money).

# REQUIRED — the Base wallet address that receives x402 payments.
PAY_TO_ADDRESS=0xYourBaseWalletAddress

# Network. Testnet: eip155:84532  |  Mainnet: eip155:8453
NETWORK=eip155:84532

# Facilitator for testnet. NOTE: the correct host is x402.org/facilitator,
# NOT facilitator.x402.org. Ignored on mainnet (CDP is used instead).
FACILITATOR_URL=https://x402.org/facilitator

# Mainnet only — REQUIRED when NETWORK=eip155:8453. The server refuses to start
# on mainnet unless BOTH of these are set (real USDC settlement needs CDP).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Port to listen on (Railway sets PORT automatically in production).
PORT=3000
